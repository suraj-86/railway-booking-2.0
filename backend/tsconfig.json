{
  "compilerOptions": {
    "target": "ES2022",                          /* Specify ECMAScript target version */
    "module": "NodeNext",                        /* Use modern Node module resolution */
    "moduleResolution": "NodeNext",              /* Ensure TypeScript resolves modules properly */
    "esModuleInterop": true,                     /* Enables emit interoperability between CommonJS and ES Modules */
    "forceConsistentCasingInFileNames": true,    /* Ensure correct casing */
    "strict": true,                              /* Enable all strict type-checking options */
    "skipLibCheck": true                         /* Skip type checking of declaration files */
  },
  "include": ["src/**/*", "prisma.config.ts"]    /* Tell TS which files to watch */
}