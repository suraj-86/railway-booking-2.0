generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. User Table (Handles Authentication & Roles)
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String   // Will store the secure Bcrypt hash
  role      Role     @default(USER)
  bookings  Booking[]
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}

// 2. Station Table (Master list of stations, managed by admins)
model Station {
  id        String   @id @default(uuid())
  code      String   @unique // e.g. "NDLS"
  name      String           // e.g. "New Delhi"
  city      String
  createdAt DateTime @default(now())

  trainsFrom Train[] @relation("SourceStation")
  trainsTo   Train[] @relation("DestinationStation")
}

// 3. Train Table (The Master Schedule)
model Train {
  id            String    @id @default(uuid())
  trainNumber   String    @unique
  name          String
  sourceId      String
  source        Station   @relation("SourceStation", fields: [sourceId], references: [id])
  destinationId String
  destination   Station   @relation("DestinationStation", fields: [destinationId], references: [id])
  departure     DateTime
  arrival       DateTime
  totalSeats    Int
  price         Int      @default(500) // <-- ADD THIS LINE
  seats         Seat[]
  bookings      Booking[]
}

// 4. Seat Table (For Visual Seat Selection)
model Seat {
  id         String   @id @default(uuid())
  trainId    String
  train      Train    @relation(fields: [trainId], references: [id], onDelete: Cascade)
  seatNumber String   // e.g., "A1", "B12"
  coach      String   // e.g., "S1", "B1"
  type       SeatType 
  isBooked   Boolean  @default(false)
  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id])
}

enum SeatType {
  WINDOW
  AISLE
  MIDDLE
}

// 5. Booking Table (Links Users, Trains, and Seats)
model Booking {
  id          String        @id @default(uuid())
  pnr         String        @unique 
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  trainId     String
  train       Train         @relation(fields: [trainId], references: [id])
  seats       Seat[]
  status      BookingStatus @default(CONFIRMED)
  totalAmount Float
  createdAt   DateTime      @default(now())
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  WAITLISTED
}