generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  bookings  Booking[]
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}

model Station {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  city      String
  createdAt DateTime @default(now())

  trainsFrom Train[] @relation("SourceStation")
  trainsTo   Train[] @relation("DestinationStation")
}

model Train {
  id            String    @id @default(uuid())
  trainNumber   String    @unique
  name          String
  sourceId      String
  source        Station   @relation("SourceStation", fields: [sourceId], references: [id])
  destinationId String
  destination   Station   @relation("DestinationStation", fields: [destinationId], references: [id])
  departure     DateTime
  arrival       DateTime
  totalSeats    Int
  price         Int      @default(500)
  seats         Seat[]
  bookings      Booking[]
}

model Seat {
  id         String   @id @default(uuid())
  trainId    String
  train      Train    @relation(fields: [trainId], references: [id], onDelete: Cascade)
  seatNumber String
  coach      String
  type       SeatType 
  isBooked   Boolean  @default(false)
  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id])
}

enum SeatType {
  WINDOW
  AISLE
  MIDDLE
}

model Booking {
  id          String        @id @default(uuid())
  pnr         String        @unique 
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  trainId     String
  train       Train         @relation(fields: [trainId], references: [id])
  seats       Seat[]
  status      BookingStatus @default(CONFIRMED)
  totalAmount Float
  createdAt   DateTime      @default(now())
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  WAITLISTED
}
